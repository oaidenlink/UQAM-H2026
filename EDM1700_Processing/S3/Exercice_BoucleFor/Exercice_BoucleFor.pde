size(800, 400);
background(#668378);

// pos cercles
int posX = 0;
int posY = 0;
int posBottom = 100;





noStroke();

for(posY = 0; posY <= height; posY+=50) {
 for(posX = 0; posX <= width; posX+=50) {
   fill(#7AAF9B);
   circle(posX, posY, 50); 
  }
}

fill(#C3F3F7);
stroke(
rect(40, 40, width/6, height/2);




for (int i=0; i<=12; i+=1) {
